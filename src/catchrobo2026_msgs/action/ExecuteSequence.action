# UI identity and selected collectors; positions use the UI's zero-based indices.
uint64 control_epoch
uint64 step_id
uint8 PICK=1
uint8 PLACE=2
# Run the configured start sequence; positions are ignored and collector_mask must be 7.
uint8 START=4
# Lifecycle sequences also ignore positions and require collector_mask=7.
uint8 INITIALIZE=5
uint8 END=6
uint8 kind
uint8 row
uint8 column
uint8 box
uint8 box_column
uint8 collector_mask
---
bool success
string message
---
uint32 step_index
string phase
# Increments on each manual wait within this action; initially zero.
uint64 manual_token
# Controls allowed by the current manual gate; zero outside MANUAL_WAIT.
uint32 MANUAL_CONTROL_X=1
uint32 MANUAL_CONTROL_Y=2
uint32 MANUAL_CONTROL_Z=4
uint32 MANUAL_CONTROL_PHI=8
uint32 MANUAL_CONTROL_INITIALIZE=16
uint32 MANUAL_CONTROL_PUMP=32
uint32 MANUAL_CONTROL_ENDEFFECTOR=64
uint32 MANUAL_CONTROL_ALL=127
uint32 manual_allowed_controls
