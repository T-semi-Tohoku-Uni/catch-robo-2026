# UI identity and selected collectors; positions use the UI's zero-based indices.
uint64 control_epoch
uint64 step_id
uint8 PICK=1
uint8 PLACE=2
# Run the configured start sequence; positions are ignored and collector_mask must be 7.
uint8 START=4
# Lifecycle sequences also ignore positions and require collector_mask=7.
uint8 INITIALIZE=5
uint8 END=6
uint8 kind
uint8 row
uint8 column
uint8 box
uint8 box_column
uint8 collector_mask
---
bool success
string message
---
uint32 step_index
string phase
# Increments on each manual wait within this action; initially zero.
uint64 manual_token
